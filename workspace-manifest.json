  "conformance": {
    "command": "./workspace validate repository ."
  },
  "record_authority": {
    "default": "github:njabrooks/trade-journal",
    "exceptions": [
      {
        "records": "architecture decisions",
        "authority": "repository:docs/adr",
        "rationale": "ADRs are durable repository records; GitHub Work Items coordinate changes without replacing adopted decision records."
      }
    ]
  },
  "tracker": {
    "provider": "github",
    "location": "njabrooks/trade-journal",
    "triage_roles": {
      "needs-triage": {
        "label": "needs-triage",
        "meaning": "Maintainer needs to evaluate this Work Item."
      },
      "needs-info": {
        "label": "needs-info",
        "meaning": "Waiting on the reporter for more information."
      },
      "ready-for-agent": {
        "label": "ready-for-agent",
        "meaning": "Fully specified and ready for an AFK agent."
      },
      "ready-for-human": {
        "label": "ready-for-human",
        "meaning": "Requires human implementation or judgment."
      },
      "wontfix": {
        "label": "wontfix",
        "meaning": "Will not be actioned."
      }
    }
  },
