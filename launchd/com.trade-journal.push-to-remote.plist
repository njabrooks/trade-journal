<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.trade-journal.push-to-remote</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>cd /Users/twotrees/Desktop/trade-journal &amp;&amp; /opt/homebrew/bin/npx tsx scripts/push-to-remote.ts >> /Users/twotrees/Desktop/trade-journal/logs/push-to-remote.log 2>&amp;1</string>
    </array>

    <!-- Run at 7 AM UTC (daily backup) -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/twotrees/Desktop/trade-journal/logs/push-to-remote.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/twotrees/Desktop/trade-journal/logs/push-to-remote.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
