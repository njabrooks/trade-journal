<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.trade-journal.supabase-start</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>sleep 30 && cd /Users/twotrees/Desktop/trade-journal && /opt/homebrew/bin/npx supabase start >> /Users/twotrees/Desktop/trade-journal/logs/supabase-start.log 2>&1</string>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/twotrees/Desktop/trade-journal/logs/supabase-start.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/twotrees/Desktop/trade-journal/logs/supabase-start.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <!-- Run once at login -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Don't restart if it exits -->
    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
