<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.trade-journal.signal-monitoring</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>cd /Users/twotrees/Projects/trade-journal &amp;&amp; git pull --ff-only &amp;&amp; /opt/homebrew/bin/npx dotenv -e .env.local -- npx tsx scripts/daily-signal-monitoring.ts >> /Users/twotrees/Projects/trade-journal/logs/signal-monitoring.log 2>&amp;1</string>
    </array>

    <!-- Run at 08:00 UTC (morning triage before market open) -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/twotrees/Projects/trade-journal/logs/signal-monitoring.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/twotrees/Projects/trade-journal/logs/signal-monitoring.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
