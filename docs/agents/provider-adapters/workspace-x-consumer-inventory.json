{
  "schema_version": "1.0.0",
  "authority": "scope:trade-journal",
  "as_of": "2026-08-16",
  "support_state": "current",
  "consumers": [
    {
      "id": "workspace-x-read",
      "path": "scripts/ops/x-read.py",
      "execution_class": "deterministic-read-only",
      "workspace_service": "trade-journal.x-read",
      "credential_identities": ["x.auth-token", "x.ct0"],
      "denied_credential_sources": [
        "Bird raw token flags",
        "Bird Chrome/Chromium profile extraction",
        "Bird Firefox profile extraction",
        "Bird cookie-source selection"
      ],
      "allowed_operations": [
        "about",
        "bookmarks",
        "followers",
        "following",
        "home",
        "likes",
        "list-timeline",
        "lists",
        "mentions",
        "news",
        "read",
        "replies",
        "search",
        "thread",
        "trending",
        "user-tweets",
        "whoami"
      ],
      "writes": [],
      "failure_behavior": "Missing, denied, malformed, stale, or unavailable credentials and providers fail closed with redacted diagnostics.",
      "validation": {
        "deterministic": "/opt/homebrew/bin/python3 -B scripts/ops/x-read.py --self-test",
        "authenticated_probe": "whoami through Workspace service trade-journal.x-read"
      },
      "compatibility": "Direct X_AUTH_TOKEN/X_CT0 inheritance is migration-only and is removed by projects#35 after every adoption ticket closes, the final legacy consumer stops, credentials rotate, authorised services reload, redacted probes pass, and health baselines restart."
    }
  ],
  "superseded_stores": [
    {
      "path_identity": ".env.local",
      "value_recorded": false,
      "state": "superseded-retained-for-migration-only",
      "removal_gate": "projects#35 after final legacy consumer stop and credential rotation"
    }
  ]
}
